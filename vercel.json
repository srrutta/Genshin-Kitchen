{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**", "public/**", "genshin-food/**", "genshin-shop/**", "menu.json"]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/images/(.*)", "dest": "server.js" },
    { "src": "/shop-images/(.*)", "dest": "server.js" },
    { "src": "/(menu|orders|history|undo)(/.*)?", "dest": "server.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}